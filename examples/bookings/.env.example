# Database
PG_HOST=localhost
PG_PORT=5562
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=bookings_development

# Auth
JWT_SECRET=change_me_in_production

# App
LOG_LEVEL=warn

# Bookings
# Where the office is, for "today" and "now" (a name PostgreSQL knows).
BOOKINGS_TZ=UTC
# The address of the app, for the links in the mails it sends.
BOOKINGS_URL=http://localhost:3000
# An address told (POST, JSON) about every confirmed booking. Leave it out to tell nobody.
# BOOKINGS_WEBHOOK_URL=https://example.org/hooks/bookings

# Mail: log (the default: the mail is written to the log), brevo, resend or postmark,
# with BREVO_API_KEY, RESEND_API_KEY or POSTMARK_SERVER_TOKEN.
MAIL_TRANSPORT=log
MAIL_FROM=Bookings <bookings@example.org>
